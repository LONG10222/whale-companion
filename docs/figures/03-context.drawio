        </mxCell>
        <mxCell id="m" value="同联系人记忆 ChatMemory&#10;&#10;最近 24 条消息&#10;原话及消息 ID 支撑的长期信息&#10;已认可学习 / LifeMemory&#10;引用关系与联系人隔离" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#c5d0dc;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#334155;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
