        <mxCell id="p" value="人格资料 PersonaStore&#10;&#10;核心规则 + 角色 JSON&#10;最多 8 条风格示例（非真实历史）&#10;关键词 / 常驻 lore，最多 2400 字符&#10;损坏配置沿用最近有效版本" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#c5d0dc;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#334155;align=center;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
